# Now implement Fuzzy C-means clustering
# Feature extraction and preparation for FCM
# For demonstration, we'll use the same features as K-means
# We'll create a train/test split to evaluate the clustering
# Split the data into training and testing sets (80% train, 20% test)
X_train, X_test = train_test_split(X, test_size=0.2, random_state=42)
# Standardize the features
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)
# Implement Fuzzy C-means with 10 clusters (to match K-means)
n_clusters = 10
m = 1.5  # Fuzziness parameter (typically between 1.5 and 3.0)
error = 0.005  # Stopping criterion
maxiter = 3000  # Maximum number of iterations
# Execute FCM on training data
cntr, u_matrix, u0, d, jm, p, fpc = cmeans(
    X_train_scaled.T,  # skfuzzy expects transposed data
    n_clusters,
    m,
    error=error,
    maxiter=maxiter,
    init=None
)
# Get hard cluster assignments from fuzzy membership
fcm_train_labels = np.argmax(u_matrix, axis=0)
# Use the trained centroids to predict on test data
u_test, u0, d, jm, p, fpc = cmeans_predict(
    X_test_scaled.T,  # Transpose for skfuzzy
    cntr,  # Centers from training
    m,  # Same fuzziness parameter
    error=error,
    maxiter=maxiter
)
# Convert to hard labels
fcm_test_labels = np.argmax(u_test, axis=0)
# Calculate silhouette score for FCM on training data
fcm_train_silhouette = silhouette_score(X_train_scaled, fcm_train_labels)
print(f"Fuzzy C-means Training Silhouette Score with {n_clusters} clusters: {fcm_train_silhouette:.4f}")
# Calculate silhouette score for FCM on test data
fcm_test_silhouette = silhouette_score(X_test_scaled, fcm_test_labels)
print(f"Fuzzy C-means Test Silhouette Score with {n_clusters} clusters: {fcm_test_silhouette:.4f}")
# Calculate Fuzzy C-means silhouette scores for different numbers of clusters
fcm_silhouette_scores_train = []
fcm_silhouette_scores_test = []
fpcs = []
for c in range_n_clusters:
    # Train FCM
    cntr, u_matrix, u0, d, jm, p, fpc = cmeans(
        X_train_scaled.T,
        c,
        m,
        error=error,
        maxiter=maxiter,
        init=None
    )
    
    # Get training labels
    fcm_train_labels = np.argmax(u_matrix, axis=0)
    
    # Predict on test data
    u_test, u0, d, jm, p, fpc = cmeans_predict(
        X_test_scaled.T,
        cntr,
        m,
        error=error,
        maxiter=maxiter
    )
    
    # Get test labels
    fcm_test_labels = np.argmax(u_test, axis=0)
    
    # Calculate silhouette scores
    train_silhouette = silhouette_score(X_train_scaled, fcm_train_labels)
    test_silhouette = silhouette_score(X_test_scaled, fcm_test_labels) 
    
    fcm_silhouette_scores_train.append(train_silhouette)
    fcm_silhouette_scores_test.append(test_silhouette)
    fpcs.append(fpc)
    
    print(f"For FCM with n_clusters = {c}:")
    print(f"  - Training silhouette score: {train_silhouette:.4f}")
    print(f"  - Test silhouette score: {test_silhouette:.4f}")
    print(f"  - Fuzzy Partition Coefficient: {fpc:.4f}")
# Plot comparison between K-means and FCM
plt.figure(figsize=(15, 10))
# Plot 1: Silhouette Scores Comparison
plt.subplot(2, 2, 1)
plt.plot(range_n_clusters, silhouette_scores, 'o-', label='K-means')
plt.plot(range_n_clusters, fcm_silhouette_scores_train, 's-', label='FCM (Train)')
plt.xlabel('Number of Clusters')
